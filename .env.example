# Required (or enter the key in the UI instead)
DEEPSEEK_API_KEY=

# Optional
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_EXTRACTOR=deepseek-chat
LLM_MODEL_RESPONDER=deepseek-chat
# Fix "today" for deadline checks, e.g. 2026-03-01 keeps CL-2048's appeal window open
SOP_TODAY=2026-03-01
VERIFY_MIN_FIELDS=3
MAX_VERIFY_FAILURES=3
MAX_OFF_TOPIC=3
PERSUASION_BUDGET=3
CONSENT_SCENARIO=default
