# Required (or enter the key in the UI instead)
DEEPSEEK_API_KEY=

# Optional
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_EXTRACTOR=deepseek-chat
LLM_MODEL_RESPONDER=deepseek-chat

# "Today" for deadline checks. Empty or "demo" = 2026-03-01 (CL-2048's appeal window is open),
# "real" = the system date, or a fixed YYYY-MM-DD date. The UI shows which one is in use.
SOP_TODAY=

VERIFY_MIN_FIELDS=3
MAX_VERIFY_FAILURES=3
MAX_OFF_TOPIC=3
PERSUASION_BUDGET=3
CONSENT_SCENARIO=default

# Show which identity field matched or failed in the inspector. Local testing only:
# on a public deployment it would let anyone probe the records.
DEBUG_INSPECTOR=false

# Public deployment
# ACCESS_TOKEN=            # if set, the UI asks for this code before any chat
RATE_LIMIT_PER_MINUTE=30
SESSION_TTL_MINUTES=30
MAX_SESSIONS=200
MAX_MESSAGE_CHARS=2000
MAX_TURNS=60
